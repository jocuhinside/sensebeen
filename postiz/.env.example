# cp .env.example .env  — then fill in.
# Public URL the Doogee (and browsers) reach Postiz at. Put it behind your own
# reverse proxy / Tor onion / WireGuard; do not expose :5000 raw.
MAIN_URL=https://postiz.example.org
FRONTEND_URL=https://postiz.example.org
NEXT_PUBLIC_BACKEND_URL=https://postiz.example.org/api

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Flip to true after creating your first account.
DISABLE_REGISTRATION=false
# Bind address for :5000. 127.0.0.1 behind a proxy; 0.0.0.0 for LAN/WireGuard-only.
POSTIZ_BIND=127.0.0.1

# Social provider credentials (add only what you use), e.g.:
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
