# Account-level DocuSeal API key (Settings > API). Lives only here, never with any client.
DOCUSEAL_API_KEY=
# https://api.docuseal.com (US) or https://api.docuseal.eu (EU)
DOCUSEAL_API_BASE=https://api.docuseal.com
# JSON array of client entries; generate each with `npm run mint -- <id> ...`
ESIGN_CLIENTS=[]
