# cp postiz.env.example postiz.env && chmod 600 postiz.env
# API key: Postiz UI -> Settings -> Public API
POSTIZ_URL=https://postiz.example.org
POSTIZ_API_KEY=
# Integration (channel) IDs, comma-separated. List with: ./postiz-post.sh channels
POSTIZ_CHANNELS=
# now | schedule | draft  (draft is the safe default: nothing publishes without review)
POSTIZ_MODE=draft
# Provider settings blob merged per channel; most need {"__type":"<provider>"}.
# Map as channelId=provider, comma-separated, e.g. abc123=x,def456=linkedin
POSTIZ_PROVIDERS=
